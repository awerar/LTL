#!/usr/bin/env python3
r"""Print a derivation or countermodel for an LTL formula, readably.

    tools/show-proof 'G p -> p'               numbered proof from decidePC
    tools/show-proof '□ pv ⇒ pv'              the same, in Agda syntax
    tools/show-proof --tree 6 'G p -> p'      the proof tree, to depth 6
    tools/show-proof --expr 'renderDeriv (dne {pv})'   any String expression

FORMULA may be written in ASCII or in the Agda syntax of LTL.Formula; the two
can be mixed.  ASCII words and operators are translated as follows:

    ~  !  not          ¬          ->  =>             ⇒
    X  next            ○          <->  <=>           ⇔
    G  []  always      □          &  /\  and         ∧
    F  <>  eventually  ◇          |  \/  or          ∨
    true  false        ⊤  ⊥

and the variables p q r s t and x0, x1, ... become var 0 .. var 4 and
var N, the names LTL.Pretty prints them with.  Precedence is Agda's: the
prefix operators bind tightest, then ∧, ∨, ⇒ (right associative), ⇔.
Any other name is passed to Agda unchanged.  The formula is evaluated in a
module that opens LTL.Pretty and LTL.Examples, so pv, qv, axT, ... can be
used as well.
The rendering is done by LTL.Pretty; this script only runs
`agda --interaction-json`, asks it to normalise the expression, and prints the
resulting string without quotes and escapes.  Set AGDA to choose the binary.
"""

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

SCRATCH = """{-# OPTIONS --safe --without-K --exact-split #-}
module ShowProofScratch where
open import LTL.Pretty
open import LTL.Examples
"""


_ASCII_OPS = {
    "~": "¬", "!": "¬", "not": "¬",
    "->": "⇒", "=>": "⇒", "<->": "⇔", "<=>": "⇔",
    "&": "∧", "/\\": "∧", "and": "∧", "|": "∨", "\\/": "∨", "or": "∨",
    "X": "○", "next": "○", "G": "□", "[]": "□", "always": "□",
    "F": "◇", "<>": "◇", "eventually": "◇",
    "true": "⊤", "false": "⊥",
}
_VARS = {"p": 0, "q": 1, "r": 2, "s": 3, "t": 4}
_ASCII_TOKEN = re.compile(
    r"<->|<=>|->|=>|/\\|\\/|\[\]|<>|[~!&|]|[A-Za-z_][A-Za-z0-9_']*|\d+|\S")


def _ascii_word(tok):
    if tok in _ASCII_OPS:
        return _ASCII_OPS[tok]
    if tok in _VARS:
        return "(var {})".format(_VARS[tok])
    m = re.fullmatch(r"x(\d+)", tok)
    if m:
        return "(var {})".format(int(m.group(1)))
    return tok


def translate(formula):
    """ASCII LTL syntax to the Agda syntax of LTL.Formula.

    The input is split at whitespace and parentheses.  A chunk that is pure
    ASCII is tokenised and translated; any other chunk (Agda's own Unicode
    syntax, or a name like ◇P) is passed through as it is."""
    out = []
    for chunk in re.findall(r"[()]|[^\s()]+", formula):
        if chunk in "()" or not chunk.isascii():
            out.append(chunk)
        else:
            out.extend(_ascii_word(t) for t in _ASCII_TOKEN.findall(chunk))
    return " ".join(out)


def hs_string(s):
    """Quote s as a Haskell string literal (the IOTCM argument syntax)."""
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


_ESC = re.compile(r'\\(\d+|[ntr\\"\'&abfv])')
_SIMPLE = {"n": "\n", "t": "\t", "r": "\r", "\\": "\\", '"': '"', "'": "'",
           "&": "", "a": "\a", "b": "\b", "f": "\f", "v": "\v"}


def unquote(lit):
    """Decode an Agda string literal as printed by Agda (Haskell escapes)."""
    lit = lit.strip()
    if len(lit) < 2 or lit[0] != '"' or lit[-1] != '"':
        return lit                       # not a literal: show it as it is
    body = lit[1:-1]
    return _ESC.sub(lambda m: chr(int(m.group(1))) if m.group(1).isdigit()
                    else _SIMPLE[m.group(1)], body)


def run(expr):
    agda = os.environ.get("AGDA", "agda")
    with tempfile.TemporaryDirectory(prefix="show-proof-") as tmp:
        src = os.path.join(tmp, "ShowProofScratch.agda")
        with open(src, "w", encoding="utf-8") as f:
            f.write(SCRATCH)
        load = ('IOTCM {f} NonInteractive Indirect (Cmd_load {f} [{a},{b},{c},{d}])'
                .format(f=hs_string(src), a=hs_string("-i"), b=hs_string(tmp),
                        c=hs_string("-i"), d=hs_string(REPO)))
        comp = ('IOTCM {f} NonInteractive Indirect '
                '(Cmd_compute_toplevel DefaultCompute {e})'
                .format(f=hs_string(src), e=hs_string("show (" + expr + ")")))
        proc = subprocess.run([agda, "--interaction-json"], cwd=REPO,
                              input=load + "\n" + comp + "\n",
                              capture_output=True, text=True, encoding="utf-8")
    for line in proc.stdout.splitlines():
        line = line.removeprefix("JSON> ").strip()
        if not line.startswith("{"):
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        if msg.get("kind") != "DisplayInfo":
            continue
        info = msg.get("info", {})
        if info.get("kind") == "NormalForm":
            return unquote(info.get("expr", "")), 0
        if info.get("kind") == "Error":
            err = info.get("error", info)
            return str(err.get("message", err)), 1
        if info.get("kind") == "AllGoalsWarnings" and info.get("errors"):
            return "\n".join(str(e.get("message", e)) for e in info["errors"]), 1
    return ("no answer from Agda\n" + proc.stderr + proc.stdout[-2000:]), 1


def main():
    ap = argparse.ArgumentParser(
        description="Readable LTL proofs and countermodels (via LTL.Pretty).",
        epilog=__doc__.split("\n\n", 1)[1],
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("formula", nargs="?",
                    help="the formula, in ASCII ('G p -> p') or Agda syntax ('□ pv ⇒ pv')")
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument("--tree", metavar="DEPTH", type=int,
                      help="print the proof tree to this depth instead")
    mode.add_argument("--raw", action="store_true",
                      help="print the formula itself without abbreviations")
    ap.add_argument("--expr", help="evaluate this String expression instead")
    args = ap.parse_args()

    if args.expr is not None:
        expr = args.expr
    elif args.formula is None:
        ap.error("give a formula or --expr")
    else:
        formula = translate(args.formula)
        if args.tree is not None:
            expr = "proveTree {} ({})".format(args.tree, formula)
        elif args.raw:
            expr = "showFormulaRaw ({})".format(formula)
        else:
            expr = "prove ({})".format(formula)

    out, code = run(expr)
    if code != 0 and args.expr is None:
        out = out.rstrip("\n") + "\n\n(sent to Agda: " + expr + ")"
        if "Not in scope" in out:
            out += ("\n(variables are p q r s t or x0, x1, ...; "
                    "operators: see tools/show-proof --help)")
    sys.stdout.write(out if out.endswith("\n") else out + "\n")
    sys.exit(code)


if __name__ == "__main__":
    main()
